<!DOCTYPE html>
<html lang="pl">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, user-scalable=0"
		/>
		<link rel="icon" type="image/png" href="./dist/img/logo_donmartino.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
			rel="stylesheet"
		/>
		<link
			rel="stylesheet"
			href="https://unpkg.com/swiper/swiper-bundle.min.css"
		/>
		<link rel="stylesheet" href="./dist/css/main.min.css" />
		<script
			src="https://kit.fontawesome.com/9bf94860b7.js"
			crossorigin="anonymous"
		></script>
		<title>Don Martino</title>
	</head>
	<body>
		<div class="wrap">
			<!-- @include 'nav.kit'-->
			<main>
				<section class="contact">
					<div class="contact__wrap">
						<h1 class="contact__title">Kontakt</h1>
						<p class="contact__name">Don Martino - Marcin Bajor</p>
						<div class="contact__box">
							<div class="contact__info">
								<p class="contact__item">
									<i class="fas fa-map-marker-alt"></i>
									<span>ul. Polna 3a, 36-100 Kolbuszowa</span>
								</p>
								<p class="contact__item" style="display: none">
									<i class="fa-solid fa-envelope"></i>
									<span>karolina61@o2.pl</span>
								</p>
								<p class="contact__item">
									<i class="fa-solid fa-phone"></i>
									<a href="tel:+48781631804" class="js-phone">781 631 804</a>
								</p>

								<p class="contact__item">
									<a
										href="https://www.facebook.com/DonMartinoKlb"
										target="_blank"
										><i class="fa-brands fa-facebook"></i> Facebook</a
									>
								</p>
								<p class="contact__item">
									<a
										href="https://www.instagram.com/donmartinoklb/"
										target="_blank"
										><i class="fa-brands fa-instagram"></i> Instagram</a
									>
								</p>
								<div class="contact__item">
									<div class="contact__hours">
										<i class="fa-regular fa-clock"></i>
										<p>Godziny otwarcia:</p>
									</div>
									<p>Poniedziałek: <b>Nieczynne*</b></p>
									<p>Wtorek: <b>16-21**</b></p>
									<p>Środa - Czwartek: <b>14-21**</b></p>
									<p>Piątek - Sobota: <b>14-22**</b></p>
									<p>Niedziela: <b>14-21**</b></p>
									<p class="contact__sunday">
										*Odpoczywamy. Uzupełniamy ciasto i składniki.
									</p>
									<p class="contact__sunday">
										**Są to nasze tradycyjne godziny otwarcia. Czasami występują
										sytuacje, od nas niezależne gdzie działamy w innych
										godzinach lub zwyczajnie jest <b>sold out</b> ciasta, o czym
										informujemy na naszych socialach!
									</p>
								</div>
							</div>
							<div class="contact__logo"></div>
						</div>
						<div class="contact__maps">
							<iframe
								src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2551.837513469723!2d21.757297699999995!3d50.2389404!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x473d1900230e29fd%3A0x781bbb97bd56dba8!2sDon%20Martino!5e0!3m2!1spl!2spl!4v1790072002799!5m2!1spl!2spl"
								width="100%"
								height="450"
								style="border: 0"
								allowfullscreen=""
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
							></iframe>
						</div>
					</div>
				</section>
			</main>
			<!-- @include 'footer.kit'-->
		</div>
		<script src="./dist/js/main.min.js"></script>
	</body>
</html>
